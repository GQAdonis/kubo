  ],
  "semanticCases": [
    {
      "name": "same accepted activity",
      "input": "initial run-1, interrupt, owned resumed run-2",
      "expected": "same server activity_id; full owner/open-ID checks unchanged"
    },
    {
      "name": "new accepted message",
      "input": "new user message in same conversation after prior activity",
      "expected": "fresh activity_id; old decisions do not migrate"
    },
    {
      "name": "rejected request",
      "input": "malformed/unauthorized request or unaccepted message",
      "expected": "no new accepted activity/correlation projection"
    },
    {
      "name": "facts switch off",
      "input": "agent.run_facts=false and run interrupts",
      "expected": "no facts event; trusted interrupt activity_id equals observation.activity_id"
    },
    {
      "name": "observation-only resume",
      "input": "native wait resumes with no model invocation/new facts",
      "expected": "retain existing activity; no fabricated run facts"
    },
    {
      "name": "no custom start fields",
      "input": "initial and resumed runs",
      "expected": "RUN_STARTED retains standard keys; activity lives only in optional namespaced/value fields"
    },
    {
      "name": "no client authority",
      "input": "client attempts to set activity_id via top-level/generic forwarded props or UAR CUSTOM",
      "expected": "not accepted as server activity; no privilege or association override"
    },
    {
      "name": "no cross-owner grouping",
      "input": "foreign observation uses same guessed activity_id",
      "expected": "full identity filter excludes it; no lookup/approval based on ID"
    },
    {
      "name": "no activity inference",
      "input": "legacy/native/MCP record lacks activity_id",
      "expected": "show association unreported; never join by tool/target/prose"
    },
    {
      "name": "no feed expansion",
      "input": "idle SSE decision changed",
      "expected": "exact id/state/revision only; authenticated fetch obtains activity_id"
    },
    {
      "name": "restart and eviction",
      "input": "activity's in-memory record disappears",
      "expected": "existing epoch/retention disclosure; no durable transcript or old continuation revival"
    }
  ]
}
