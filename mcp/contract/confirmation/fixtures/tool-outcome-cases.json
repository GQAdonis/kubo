  "semanticCases": [
    {
      "name": "receipt binds current call",
      "input": "receipt tool differs from known current tool or trusted ai.ipfs/tool marker",
      "expected": "refuse success presentation, no retry"
    },
    {
      "name": "receipt ID agrees",
      "input": "receipt.decision_id differs from envelope confirmation_id",
      "expected": "reject semantic binding; no Done"
    },
    {
      "name": "receipt digest agrees",
      "input": "receipt.effect_digest differs from envelope.effect_digest or shown immutable operation",
      "expected": "reject semantic binding; no Done"
    },
    {
      "name": "receipt time agrees",
      "input": "receipt.completed_at differs from execution.completed_at",
      "expected": "reject semantic binding; no Done"
    },
    {
      "name": "nondecreasing time",
      "input": "started_at equals completed_at and receipt agrees",
      "expected": "valid; never fabricate +1ns"
    },
    {
      "name": "backwards wall clock",
      "input": "completion clock is earlier than recorded start",
      "expected": "producer clamps completion to start; receipt agrees"
    },
    {
      "name": "inverted received time",
      "input": "received completed_at is earlier than started_at",
      "expected": "reject semantic outcome; no Done"
    },
    {
      "name": "later delivery error",
      "input": "operation receipt succeeded, result delivery produces isError=true",
      "expected": "operation success remains; show delivery error separately, never retry"
    },
    {
      "name": "ordinary legacy output",
      "input": "no _meta.ipfs-mcp namespace",
      "expected": "ordinary output remains usable; no inferred receipt/Done from bare approval"
    },
    {
      "name": "no HTTP credential dependency",
      "input": "conforming MCP App host forwards result through ui/notifications/tool-result",
      "expected": "read validated outcome through ordinary SDK; no decisions HTTP request or credential acquisition"
    },
    {
      "name": "invalid replay does not disclose",
      "input": "invalid/replayed/losing claim receives an ordinary tool error",
      "expected": "no detached lifecycle/receipt from retained other invocation"
    },
    {
      "name": "atomic detached snapshot",
      "input": "broker changes after result snapshot is built",
      "expected": "returned snapshot immutable; later refinements need existing authorized observation"
    },
    {
      "name": "metadata malformed",
      "input": "untrusted malformed/conflicting namespace",
      "expected": "fall back inertly for outcome, keep ordinary legacy payload handling; no approval/action synthesis"
    },
    {
      "name": "no result body mutation",
      "input": "successful or failed write result with metadata",
      "expected": "content/structuredContent/isError/output schema and unrelated _meta retain their ordinary meanings"
    },
    {
      "name": "no implicit receipt activity",
      "input": "valid safe result_refs in receipt",
      "expected": "display/copy only; no automatic URL fetch, CID read or operation"
    }
  ]
}
