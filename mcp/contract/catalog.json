      "paginated": false,
      "inputSchema": "schemas/tools/pin_rm.input.json",
      "outputSchema": "schemas/tools/pin_rm.output.json",
      "ui": {
        "a2uiComponent": "PinList",
        "appView": "pins"
      },
      "a2a": {
        "skill": "ipfs-pinning",
        "example": "Unpin bafy..."
      },
      "confirmationSummary": "Remove the pin on {path} (recursive={recursive})"
    },
    {
      "name": "mfs_ls",
      "group": "mfs",
