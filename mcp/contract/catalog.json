      "minKuboVersion": "0.29.0",
      "paginated": true,
      "inputSchema": "schemas/tools/pin_verify.input.json",
      "outputSchema": "schemas/tools/pin_verify.output.json",
      "ui": {
        "a2uiComponent": "PinList",
        "appView": "pins"
      },
      "a2a": {
        "skill": "ipfs-pinning",
        "example": "Are all my pins intact?"
      }
    },
    {
      "name": "pin_update",
      "group": "pin",
      "title": "Update pin",
      "description": "Move a recursive pin from one CID to another, transferring only the differences. By default (unpin true) the old pin is removed, which has the effect of pin_rm on it. Destructive: off by default, always confirmed.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "confirmation": "destructive",
      "returnsUntrustedContent": false,
      "contentEgress": false,
      "rpc": [
        "pin/update"
      ],
      "rpcOptional": [
        "pin/ls"
      ],
      "minKuboVersion": "0.29.0",
      "paginated": false,
      "inputSchema": "schemas/tools/pin_update.input.json",
      "outputSchema": "schemas/tools/pin_update.output.json",
      "ui": {
        "a2uiComponent": "PinList",
        "appView": "pins"
      },
      "a2a": {
        "skill": "ipfs-pinning",
        "example": "Replace the pin on the old site root with the new one."
      },
      "confirmationSummary": "Move pin from {from} to {to} (unpin old={unpin})"
    },
    {
      "name": "pin_rm",
      "group": "pin",
      "title": "Remove pin",
      "description": "Remove a pin. Unpinned content becomes eligible for garbage collection. Destructive: always confirmed.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
