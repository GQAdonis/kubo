{
  "$schema": "./catalog.schema.json",
  "contractVersion": "0.1.0",
  "minKuboVersion": "0.29.0",
  "toolSelection": {
    "description": "ADR-0003 section 2 (operator decision 2026-10-09). The default tool set on every transport is every group with confirmation classes none and write; destructive-class tools are excluded. They are enabled by naming the selector 'destructive' (stdio --tools or config tools.groups) or, for HTTP, AG-UI and A2A principals, by a per-principal destructive_groups grant. Enabled destructive calls are still always confirmed. read_only (--read-only) leaves only class none.",
    "destructiveSelector": "destructive",
    "default": {
      "groups": [
        "node",
        "content",
        "pin",
        "mfs",
        "names",
        "dag",
        "routing",
        "diag",
        "index"
      ],
      "classes": [
        "none",
        "write"
      ]
    },
    "readOnly": {
      "classes": [
        "none"
      ]
    }
  },
  "groups": [
    {
      "name": "node",
      "title": "Node",
      "description": "Identity, version and server status.",
      "diagnostic": true
    },
    {
      "name": "content",
      "title": "Content",
      "description": "Add and read UnixFS content.",
      "diagnostic": false
    },
    {
      "name": "pin",
      "title": "Pins",
      "description": "Pin, list, verify, update and remove pins.",
      "diagnostic": false
    },
    {
      "name": "mfs",
      "title": "MFS",
      "description": "The node's Mutable File System.",
      "diagnostic": false
    },
    {
      "name": "names",
      "title": "IPNS and keys",
      "description": "Publish and resolve IPNS names; manage keystore keys without export.",
      "diagnostic": false
    },
    {
      "name": "dag",
      "title": "DAG and CAR",
      "description": "IPLD nodes and CAR import/export.",
      "diagnostic": false
    },
    {
      "name": "routing",
      "title": "Routing",
      "description": "Find providers and peers; announce CIDs.",
      "diagnostic": false
    },
    {
      "name": "diag",
      "title": "Diagnostics",
      "description": "Peers, bandwidth, repo statistics and garbage collection.",
      "diagnostic": true
    },
    {
      "name": "index",
      "title": "Search index",
      "description": "Embedding index over content added through ipfs mcp (off unless embeddings are configured).",
      "diagnostic": false
    }
  ],
  "tools": [
    {
      "name": "ipfs_node_info",
      "group": "node",
      "title": "Node info",
      "description": "Identity and version of the connected Kubo node: peer ID, agent and Kubo version, and listen addresses.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "confirmation": "none",
      "returnsUntrustedContent": false,
      "contentEgress": false,
      "rpc": [
        "id",
        "version"
      ],
      "minKuboVersion": "0.29.0",
      "paginated": false,
      "inputSchema": "schemas/tools/ipfs_node_info.input.json",
      "outputSchema": "schemas/tools/ipfs_node_info.output.json",
      "ui": {
        "a2uiComponent": "NodeStatusPanel",
        "appView": "node-status"
      },
      "a2a": {
        "skill": "ipfs-node",
        "example": "What node am I connected to?"
      }
    },
    {
      "name": "ipfs_node_status",
      "group": "node",
      "title": "Server status",
      "description": "Status of this MCP server and its daemon connection: reachability, version gate, enabled groups, read-only mode and tools unavailable on this daemon.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "confirmation": "none",
      "returnsUntrustedContent": false,
      "contentEgress": false,
      "rpc": [
        "version",
        "commands"
      ],
      "minKuboVersion": "0.29.0",
      "paginated": false,
      "inputSchema": "schemas/tools/ipfs_node_status.input.json",
      "outputSchema": "schemas/tools/ipfs_node_status.output.json",
      "ui": {
        "a2uiComponent": "NodeStatusPanel",
        "appView": "node-status"
      },
      "a2a": {
        "skill": "ipfs-node",
        "example": "Which IPFS tools are available right now?"
      }
    },
    {
      "name": "ipfs_add",
      "group": "content",
      "title": "Add content",
      "description": "Add text or base64 bytes from the request as a UnixFS file using Kubo's default CID recipe unless recipe options are given. Never reads host files. Pinning and providing are explicit.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "confirmation": "write",
      "returnsUntrustedContent": false,
      "contentEgress": false,
      "rpc": [
        "add"
      ],
      "rpcOptional": [
        "provide/once"
      ],
      "minKuboVersion": "0.29.0",
      "paginated": false,
      "inputSchema": "schemas/tools/ipfs_add.input.json",
      "outputSchema": "schemas/tools/ipfs_add.output.json",
      "ui": {
        "a2uiComponent": "ContentCard",
        "appView": "content"
      },
      "a2a": {
        "skill": "ipfs-content",
        "example": "Add this note to IPFS and pin it."
      },
      "confirmationSummary": "Add new content to IPFS (pin={pin}, provide={provide})"
    },
    {
      "name": "ipfs_cat",
      "group": "content",
      "title": "Read file",
      "description": "Read bytes of a UnixFS file by CID or content path, with offset and length. Output is capped and marked truncated. Untrusted content.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "confirmation": "none",
      "returnsUntrustedContent": true,
      "contentEgress": true,
      "rpc": [
        "cat"
      ],
      "minKuboVersion": "0.29.0",
      "paginated": false,
      "inputSchema": "schemas/tools/ipfs_cat.input.json",
      "outputSchema": "schemas/tools/ipfs_cat.output.json",
      "ui": {
        "a2uiComponent": "ContentCard",
        "appView": "content"
      },
      "a2a": {
        "skill": "ipfs-content",
        "example": "Show me the text of bafy..."
      }
    },
    {
      "name": "ipfs_get",
      "group": "content",
      "title": "Get content",
      "description": "Describe a file or directory by CID or content path and return small text files inline; larger or directory content is returned as an ipfs:// resource link. Untrusted content.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "confirmation": "none",
      "returnsUntrustedContent": true,
      "contentEgress": true,
      "rpc": [
        "files/stat",
        "cat"
      ],
      "minKuboVersion": "0.29.0",
      "paginated": false,
      "inputSchema": "schemas/tools/ipfs_get.input.json",
      "outputSchema": "schemas/tools/ipfs_get.output.json",
      "ui": {
        "a2uiComponent": "ContentCard",
        "appView": "content"
      },
      "a2a": {
        "skill": "ipfs-content",
        "example": "Fetch /ipfs/bafy.../readme.md"
      }
    },
    {
      "name": "ipfs_ls",
      "group": "content",
      "title": "List directory",
      "description": "List the entries of a UnixFS directory by CID or content path, with cursor pagination. Entry names are untrusted content.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "confirmation": "none",
      "returnsUntrustedContent": true,
      "contentEgress": true,
      "rpc": [
        "ls"
      ],
      "minKuboVersion": "0.29.0",
      "paginated": true,
      "inputSchema": "schemas/tools/ipfs_ls.input.json",
      "outputSchema": "schemas/tools/ipfs_ls.output.json",
      "ui": {
        "a2uiComponent": "ContentCard",
        "appView": "content"
      },
      "a2a": {
        "skill": "ipfs-content",
        "example": "What is inside this directory CID?"
      }
    },
    {
      "name": "pin_ls",
      "group": "pin",
      "title": "List pins",
      "description": "List pins of the connected node with cursor pagination, optionally filtered by type, CID or pin name.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "confirmation": "none",
      "returnsUntrustedContent": false,
      "contentEgress": true,
      "rpc": [
        "pin/ls"
      ],
      "minKuboVersion": "0.29.0",
      "paginated": true,
      "inputSchema": "schemas/tools/pin_ls.input.json",
      "outputSchema": "schemas/tools/pin_ls.output.json",
      "ui": {
        "a2uiComponent": "PinList",
        "appView": "pins"
      },
      "a2a": {
        "skill": "ipfs-pinning",
        "example": "List my recursive pins."
      }
    },
    {
      "name": "pin_add",
      "group": "pin",
      "title": "Pin content",
      "description": "Pin a CID or content path on the connected node, fetching missing blocks from the network.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "confirmation": "write",
      "returnsUntrustedContent": false,
      "contentEgress": false,
      "rpc": [
        "pin/add"
      ],
      "minKuboVersion": "0.29.0",
      "paginated": false,
      "inputSchema": "schemas/tools/pin_add.input.json",
      "outputSchema": "schemas/tools/pin_add.output.json",
      "ui": {
        "a2uiComponent": "PinList",
        "appView": "pins"
      },
      "a2a": {
        "skill": "ipfs-pinning",
        "example": "Pin bafy... as 'project docs'."
      },
      "confirmationSummary": "Pin {path} (recursive={recursive})"
    },
    {
      "name": "pin_verify",
      "group": "pin",
      "title": "Verify pins",
      "description": "Verify that pinned DAGs are complete and their blocks are intact, with cursor pagination over pins.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "confirmation": "none",
      "returnsUntrustedContent": false,
      "contentEgress": true,
      "rpc": [
        "pin/verify"
