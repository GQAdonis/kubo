{
  "$schema": "../ipfs-mcp-config.schema.json",
  "embeddings": {
    "mode": "remote",
    "remote": {
      "endpoint": "https://surreal.internal.example:8000",
      "namespace": "ipfs",
      "database": "index",
      "credential": {
        "env": "SURREAL_CREDENTIALS"
      }
    },
    "embedder": {
      "base_url": "https://embed.internal.example/v1",
      "model": "bge-m3",
      "dimensions": 1024,
      "api_key": {
        "file": "/etc/ipfs-mcp/embedder.key"
      }
    },
    "extractor": {
      "mode": "remote",
      "remote": {
        "base_url": "https://xberg.internal.example:8000",
        "credential": {
          "env": "IPFS_MCP_XBERG_PROXY_TOKEN"
        }
      }
    },
    "bulk": {
      "enabled": false
    },
    "search_route": {
      "enabled": false
    }
  }
}
