{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "routing_findprovs output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cid": {
      "$ref": "../common.json#/$defs/Cid"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "addrs"
        ],
        "properties": {
          "id": {
            "$ref": "../common.json#/$defs/PeerId"
          },
          "addrs": {
            "type": "array",
            "items": {
              "$ref": "../common.json#/$defs/Multiaddr"
            }
          }
        }
      }
    }
  },
  "required": [
    "cid",
    "providers"
  ]
}
