{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "car_import output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cid",
          "pinned"
        ],
        "properties": {
          "cid": {
            "$ref": "../common.json#/$defs/Cid"
          },
          "pinned": {
            "type": "boolean"
          },
          "pin_error": {
            "type": "string"
          }
        }
      }
    },
    "block_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "roots"
  ]
}
