{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ipfs_index_search input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 5
    },
    "cid": {
      "$ref": "../common.json#/$defs/Cid",
      "description": "Only search chunks of this CID."
    }
  },
  "required": [
    "query"
  ]
}
