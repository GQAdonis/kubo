{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mfs_read input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "$ref": "../common.json#/$defs/MfsPath"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576,
      "description": "Maximum bytes to return (cap 1048576). Defaults to the cap."
    },
    "encoding": {
      "$ref": "../common.json#/$defs/Encoding",
      "default": "utf8"
    }
  },
  "required": [
    "path"
  ]
}
