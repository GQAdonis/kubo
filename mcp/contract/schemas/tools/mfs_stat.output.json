{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mfs_stat output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "$ref": "../common.json#/$defs/MfsPath"
    },
    "cid": {
      "$ref": "../common.json#/$defs/Cid"
    },
    "type": {
      "type": "string",
      "enum": [
        "file",
        "directory"
      ]
    },
    "size": {
      "$ref": "../common.json#/$defs/ByteCount"
    },
    "cumulative_size": {
      "$ref": "../common.json#/$defs/ByteCount"
    },
    "blocks": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "path",
    "cid",
    "type",
    "size"
  ]
}
