{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ipfs_index_status output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "mode": {
      "type": "string",
      "enum": [
        "disabled",
        "embedded",
        "remote"
      ]
    },
    "store_reachable": {
      "type": "boolean"
    },
    "auto": {
      "type": "boolean"
    },
    "model": {
      "type": "string"
    },
    "dimensions": {
      "type": "integer",
      "minimum": 1
    },
    "indexed_cids": {
      "type": "integer",
      "minimum": 0
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 0
    },
    "cid_indexed": {
      "type": "boolean"
    },
    "by_kind": {
      "type": "object",
      "description": "Optional. Indexed-file count per content kind: each key is a kind from derivations/content-kinds.json (text, document, code, data, image, video) and each value is the number of indexed files of that kind. A kind with no indexed files may be omitted. Absent from responses of servers that predate it; clients treat absence as unknown, not zero.",
      "propertyNames": {
        "enum": ["text", "document", "code", "data", "image", "video"]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "enabled",
    "mode",
    "auto"
  ]
}
