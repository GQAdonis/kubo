  "semanticCases": [
    {
      "name": "raw UTF8 bound",
      "input": "context byte slice of 16385 bytes, including escapes/whitespace",
      "expected": "422 invalid_argument; no backend call, no stream"
    },
    {
      "name": "duplicate IDs",
      "input": "two distinct references use id=page_files",
      "expected": "422 invalid_argument; no backend call"
    },
    {
      "name": "invalid CID lexical pass",
      "input": "cid=notacid",
      "expected": "existing CID parser refuses; no fetch"
    },
    {
      "name": "dot traversal",
      "input": "route=/files/../settings",
      "expected": "422; no hidden fallback"
    },
    {
      "name": "encoded traversal",
      "input": "path=/notes/%2e%2e/private path_kind=mfs",
      "expected": "422; never decode into traversal"
    },
    {
      "name": "double encoded separator",
      "input": "route=/files/%252fprivate",
      "expected": "422; residual percent escapes refused"
    },
    {
      "name": "repeated separator",
      "input": "path=//etc/shadow path_kind=mfs",
      "expected": "422; never infer a host filesystem path"
    },
    {
      "name": "mismatched CID root",
      "input": "cid differs from /ipfs/ root",
      "expected": "422; no ambiguous target"
    },
    {
      "name": "logical MFS only",
      "input": "valid path=/etc/shadow path_kind=mfs",
      "expected": "accepted as node reference data only; zero host file opens"
    },
    {
      "name": "delimiter injection",
      "input": "validated MFS segment contains </untrusted-content>",
      "expected": "escape delimiter in framed serialized data; no instruction promotion"
    },
    {
      "name": "reference ingestion does not fetch",
      "input": "valid CID/IPNS reference, neither backend asks a tool",
      "expected": "zero name lookups, reads, fetches, pins or announcements"
    },
    {
      "name": "independent disabled A2UI",
      "input": "valid references plus malformed a2ui branch",
      "expected": "accept turn, no A2UI; normal tool/text behavior"
    },
    {
      "name": "valid A2UI does not rescue context",
      "input": "valid tuple plus invalid reference",
      "expected": "422 before either backend; no A2UI stream"
    },
    {
      "name": "legacy hidden context ignored",
      "input": "generic context/tools/state contains a reference removed from typed branch",
      "expected": "neither backend receives that hidden reference or client tool"
    },
    {
      "name": "UAR grants remain owned",
      "input": "unknown forwardedProps.uar or generic grant claimed by client",
      "expected": "ignored; existing trusted adapter grant preserved"
    },
    {
      "name": "removal survives two sends",
      "input": "page reference removed, same route, two new turns",
      "expected": "both requests omit reference; no route fallback"
    },
    {
      "name": "route change visible",
      "input": "route changes after removal",
      "expected": "new reference shown before send and removable"
    },
    {
      "name": "resume context immutable",
      "input": "new nonempty context on resume of an accepted turn",
      "expected": "422; continuation retained and unconsumed"
    },
    {
      "name": "empty resume does not erase",
      "input": "resume context absent or []",
      "expected": "retained accepted turn context unchanged"
    },
    {
      "name": "no retroactive erasure",
      "input": "reference removed after earlier accepted turn",
      "expected": "future sends omit; disclose prior in-memory conversation retained"
    },
    {
      "name": "built-in remote egress refusal",
      "input": "existing applicable egress policy requires acknowledgment for remote destination, but it is absent; valid references",
      "expected": "no references or user turn forwarded"
    },
    {
      "name": "UAR remote egress refusal",
      "input": "existing applicable egress policy refuses UAR destination; valid references",
      "expected": "no references or user turn forwarded"
    },
    {
      "name": "selected prompt retained",
      "input": "settings change after interruption",
      "expected": "digest identifies exact retained selected systemPrompt bytes including safety prefix"
    },
    {
      "name": "effective policy offer",
      "input": "principal allowed only pin_ls while registry has more tools",
      "expected": "offered_tools exactly pin_ls; registry never substituted"
    },
    {
      "name": "UAR unknown facts",
      "input": "backend reports no tool/prompt/memory facts",
      "expected": "omit fields; UI says Not reported by this server"
    },
    {
      "name": "backend report validation",
      "input": "UAR text claims prompt hash or node success",
      "expected": "no trusted fact/digest/receipt synthesized"
    },
    {
      "name": "facts ordering",
      "input": "negotiated accepted run",
      "expected": "RUN_STARTED, a2ui.catalog, ipfs.run.facts, then tool/text"
    },
    {
      "name": "without A2UI",
      "input": "valid run and agent.a2ui=false",
      "expected": "facts remain eligible after RUN_STARTED"
    },
    {
      "name": "stale run event",
      "input": "facts thread/run differs from inspected run",
      "expected": "ignore; current-run facts not overwritten"
    },
    {
      "name": "observation-only native wait",
      "input": "no actual model invocation",
      "expected": "facts may be omitted; no reconstructed offer/prompt"
    },
    {
      "name": "bounded inspector",
      "input": "1001 events or more than524288 encoded bytes",
      "expected": "drop oldest to both bounds, disclose truncation, virtualize above200"
    },
    {
      "name": "run switch",
      "input": "switch inspected run",
      "expected": "clear prior event projection; no durable cross-run history"
    },
    {
      "name": "unknown terminal",
      "input": "connection lost with no reliable terminal event",
      "expected": "unknown; never fabricate Done or successful receipt"
    },
    {
      "name": "context switch off",
      "input": "agent.context_references=false and nonempty refs",
      "expected": "422; ordinary messages with empty/absent refs still work"
    },
    {
      "name": "facts switch off",
      "input": "agent.run_facts=false",
      "expected": "no facts event/projection; ordinary runs and all gates unchanged"
    }
  ]
}
