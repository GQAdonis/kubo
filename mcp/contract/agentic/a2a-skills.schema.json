{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2A skill metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "description", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "groups", "tags", "inputModes", "outputModes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 20 },
          "groups": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "inputModes": { "type": "array", "items": { "type": "string" } },
          "outputModes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
