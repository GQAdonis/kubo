{
  "name": "@gqadonis/ipfs-mcp-app",
  "version": "0.1.0",
  "private": true,
  "description": "MCP App views for the ipfs mcp server (SEP-1865). One single-file HTML bundle per view, built on @gqadonis/ipfs-mcp-ui, served as ui://ipfs-mcp/<view>.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --dir ../ui build",
    "test": "vitest run",
    "test:scan": "node scripts/scan-bundle.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:scan && pnpm check:dist"
  },
  "dependencies": {
    "@gqadonis/ipfs-mcp-ui": "link:../ui",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
